{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Deploy Plugin (Debug Local)",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"Debug-Local.bat"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Package Release Zip",
			"type": "process",
			"command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"package-release.ps1"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Run Bandit Security Scan",
			"type": "shell",
			"command": "C:\\Program Files\\QGIS 3.44.13\\bin\\python.exe",
			"args": [
				"-m",
				"bandit",
				"-r",
				"CeeThreeDeeQTools",
				"-c",
				".bandit.yaml",
				"-f",
				"screen"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run Unit Tests",
			"type": "process",
			"command": "C:\\Program Files\\QGIS 3.44.13\\bin\\python.exe",
			"args": [
				"-m",
				"pytest",
				"-q"
			],
			"isBackground": false,
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "Run Unit Tests Verbose",
			"type": "process",
			"command": "C:\\Program Files\\QGIS 3.44.13\\bin\\python.exe",
			"args": [
				"-m",
				"pytest",
				"-v"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run Unit Tests with Coverage",
			"type": "process",
			"command": "C:\\Program Files\\QGIS 3.44.13\\bin\\python.exe",
			"args": [
				"-m",
				"pytest",
				"--cov",
				"--cov-report=term-missing"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}